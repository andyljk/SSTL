U[j,] = mvrnorm(n=1, mu = B_u%*%b_u, Sigma = (sig^2)*B_u)
}
# update sigma^2
# alpha = n*p/2 + 1
# beta = 2/frob(X-U%*%t(V))+1
# sig = 1/rgamma(n=1, alpha, 1/beta)
S = U %*% t(V)
U_draw[[t]] = U
V_draw[[t]] = V
S_draw[[t]] = S
#sig_draw = c(sig_draw, sig)
}
}
