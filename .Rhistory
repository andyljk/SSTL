geom_vline(xintercept = seq(1.5, length(unique(pct_df$y)) - 0.5, by = 1), color = "grey80", linetype = "dashed") +
geom_hline(yintercept = 0, color = "black", linewidth = 1) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8), width = 0.7, alpha = 0) +
geom_errorbar(aes(ymin = xmin, ymax = xmax, color = group), position = position_dodge(width = 0.8), width = 0.2) +
geom_point(aes(shape = group, color = group), position = position_dodge(width = 0.8), size = 2.5) +
scale_y_continuous(breaks = scales::pretty_breaks(), limits = c(-y_limit, y_limit)) +
labs(x = "POM", y = "Annualized Percent Change (%)", fill = "Age Group", color = "Age Group", shape = "Age Group", title = "Within-Group Longitudinal Percent Change (FRDA)") +
coord_flip() +
theme_minimal() +
theme(axis.text.x = element_text(angle = 0, hjust = 0.5), panel.grid.major = element_blank(), panel.grid.minor = element_blank(), panel.grid.major.x = element_line(color = "grey90"))
