library(NTL)
# function to generate correlated covariates
Gen_AR1 <- function(n,p,rho) {
if (abs(rho) >= 1) stop("rho must be in (-1, 1).")
Sigma  <- toeplitz(rho^(0:(p -1)))          # AR(1) covariance
MASS::mvrnorm(n, mu=rep(0,p), Sigma=Sigma)
}
# data (S source studies)
set.seed(456)
p     = 150 # dimension of parameter
n_t   = 50  # target sample size
n_s   = 150 # source sample size
p_0   = 15 # non-zero true coefficients
sd_y = 1
S = 1; good = c(1)
b_T    = c(rep(0.5,p_0), rep(0, p-p_0)) # true parameter, first 5 nonzero, the rest 100 are zero
X_T    = Gen_AR1(n_t,p,0.5) # matrix(rnorm(p*n_t), n_t,p) # randomly generate some covariates
logT   = X_T%*%b_T - extRemes::revd(n_t,0,sd_y) # log survival time
logC_T  = rnorm(n_t, mean(logT), sd(logT))
Y_T   = pmin(logT, logC_T)
C_T   = as.integer(logT <= logC_T)
b_s = array(NA,dim=c(p,S))
X_s = Y_s = C_s = vector(mode="list",length=S)
# generate source data
for (s in 1:S){
b_s[,s] = b_T + c(rep(-1,8),rep(0,50),rep(1,92))*(2*rbinom(p,1,0.5)-1)
if (s %in% good) b_s[,s] = b_T + rnorm(p,0,5/p)
X_s[[s]] = Gen_AR1(n_s,p,0.5) # matrix(rnorm(p*n_s), n_s,p) # randomly generate some covariates
logT_s   = X_s[[s]]%*%b_s[,s] - extRemes::revd(n_s,0,sd_y) # log survival time
logC_s  = rnorm(n_s, mean(logT_s), sd(logT_s))
Y_s[[s]]   = pmin(logT_s, logC_s)
C_s[[s]]   = as.integer(logT_s <= logC_s)
}
lam_prior = EB_SAEM_TL_AFT(X_T,Y_T,C_T,X_s,Y_s,C_s,
N=10000,
gamma_power = 0.9,
K_block=10,
schedule = 0.5, family='Weibull', slab="exp")
plot(lam_prior$mc.lam[,1])
plot(lam_prior$mc.lam[,2])
lambda_T = lam_prior$final_lam[1]; lambda_s = lam_prior$final_lam[-1]
t0   = Sys.time()
MC   = ESS_Gibbs_TL_AFT(X_T, Y_T, C_T=C_T,
X_s, Y_s, C_s=C_s,
lambda_T=lambda_T, lambda_s=lambda_s,
N=10000, family='Weibull', slab = "exp")
t1    = Sys.time()
print(t1-t0, digits = 2)
b_tl = colMeans(MC$MC_beta[5000:10000,])
sum((b_tl - b_T)^2)/sum(b_T^2)
MC.b  = t(apply(MC$mc.bt, 1, function(b) b[1:p] * T.n(b[(p+1):(2*p)] - a0_star(b[2*p+1], lambda_T) )  ))
library(NTL)
# data (S source studies)
set.seed(456)
p     = 150 # dimension of parameter
n_t   = 50  # target sample size
n_s   = 150 # source sample size
p_0   = 15 # non-zero true coefficients
sd_y = 1
S = 3; good = c(1:3)
b_T    = c(rep(0.5,p_0), rep(0, p-p_0)) # true parameter, first 5 nonzero, the rest 100 are zero
X_T    = Gen_AR1(n_t,p,0.5) # matrix(rnorm(p*n_t), n_t,p) # randomly generate some covariates
Gen_AR1 <- function(n,p,rho) {
if (abs(rho) >= 1) stop("rho must be in (-1, 1).")
Sigma  <- toeplitz(rho^(0:(p -1)))          # AR(1) covariance
MASS::mvrnorm(n, mu=rep(0,p), Sigma=Sigma)
}
