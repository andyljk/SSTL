breaks = scales::pretty_breaks(),
limits = c(-y_limit, y_limit)
) +
labs(x = "POM", y = "Value",
fill = "Age Group", color = "Age Group", shape = "Age Group",
title = "Standardized Effects and Confidence Intervals") +
coord_flip() +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 0, hjust = 1),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(color = "grey80")
)
return(list(plot = g, df = df))
}
plot_within_group_approach1 <- function(model_lists, data, var_info, child_indices, study_group) {
n_rows <- nrow(data)
if (study_group!="Control"){
Caption = "* Clinical outcomes only measured for FRDA patients"
} else{
Caption = ""
}
process_group <- function(models, age_filter_fn, is_child = FALSE) {
vals <- data.frame(lower = numeric(), upper = numeric(), coef = numeric())
current_vars_idx <- if(is_child) child_indices else 1:length(var_info$base)
for (i in seq_along(models)) {
# Map loop index back to full variable list index
full_idx <- current_vars_idx[i]
# Calculate 12-month differences
diffs <- c(data[[ var_info$v2[full_idx] ]] - data[[ var_info$base[full_idx] ]],
data[[ var_info$v3[full_idx] ]] - data[[ var_info$v2[full_idx] ]])
# Age indices
row_indices <- which(age_filter_fn(data$Age))
group_indices <- which(data$Study.group == study_group)
valid_indices <- intersect(row_indices, group_indices)
combined_indices <- c(valid_indices, valid_indices + n_rows)
group_sd <- sd(diffs[combined_indices], na.rm = TRUE)
# Extract Model Statistics
model <- models[[i]]
ci <- confint(model, method = "Wald")
target_idx <- which(rownames(ci) == "Time")
coef_raw <- summary(model)$coefficients["Time", 1]
vals <- rbind(vals, data.frame(
lower = ci[target_idx, 1] / group_sd,
upper = ci[target_idx, 2] / group_sd,
coef  = coef_raw / group_sd
))
}
# Align child group results with NAs
if (is_child) {
full_vals <- data.frame(lower = rep(NA, length(var_info$base)),
upper = rep(NA, length(var_info$base)),
coef  = rep(NA, length(var_info$base)))
full_vals[child_indices, ] <- vals
return(full_vals)
}
return(vals)
}
# --- Run Processing ---
res_adult <- process_group(model_lists$adult, function(x) x >= 18)
res_teen  <- process_group(model_lists$teen, function(x) x < 18 & x >= 11)
res_child <- process_group(model_lists$child, function(x) x < 11, is_child = TRUE)
# --- Construct Dataframe ---
all_coef  <- c(res_adult$coef,  res_teen$coef,  res_child$coef)
all_lower <- c(res_adult$lower, res_teen$lower, res_child$lower)
all_upper <- c(res_adult$upper, res_teen$upper, res_child$upper)
n_vars <- length(var_info$labels)
x_labels <- var_info$labels
df <- data.frame(
y     = factor(rep(x_labels, times = 3), levels = x_labels),
x     = all_coef,
xmin  = all_lower,
xmax  = all_upper,
group = factor(rep(c("Age >18", "Age 11-18", "Age < 10"), each = n_vars),
levels = c("Age >18", "Age 11-18", "Age < 10"))
)
df <- df[!(is.na(df$x) & df$group == "Age < 10"), ]
y_limit <- max(abs(c(df$xmax, df$xmin)), na.rm = TRUE)
g <- ggplot(df, aes(x = y, y = x, fill = group)) +
geom_vline(xintercept = seq(1.5, n_vars - 0.5, by = 1),
color = "grey60", linetype = "dashed") +
geom_hline(yintercept = 0, color = "black", linewidth = 1.2) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8), width = 0.7, alpha = 0) +
geom_errorbar(aes(ymin = xmin, ymax = xmax, color = group),
position = position_dodge(width = 0.8),
width = 0.2) +
geom_point(aes(shape = group, color = group),
position = position_dodge(width = 0.8), size = 3) +
scale_y_continuous(
breaks = scales::pretty_breaks(),
limits = c(-y_limit, y_limit)
) +
labs(x = "POM", y = "Standardized effect size (LME Time / SD of 12-month change)",
fill = "Age Group", color = "Age Group", shape = "Age Group",
title = paste(study_group, "- Within-group effect sizes (Approach 1)"),
caption = Caption) +
coord_flip() +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 0, hjust = 1),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(color = "grey80")
)
return(list(plot = g, df = df))
}
plot_within_group_approach2 <- function(age_group_data, var_info, child_indices, study_group) {
if (study_group!="Control"){
Caption = "* Clinical outcomes only measured for FRDA patients"
} else{
Caption = ""
}
process_group <- function(data_subset, age_group_name, is_child = FALSE) {
current_outcomes <- if (is_child) var_info$base[child_indices] else var_info$base
vals <- summarise_within_slope_es(
data = data_subset,
outcomes = current_outcomes,
study_group = study_group,
age_group_name = age_group_name
) %>%
transmute(
lower = Lower,
upper = Upper,
coef = ES
)
# Align child group results with NAs
if (is_child) {
full_vals <- data.frame(lower = rep(NA, length(var_info$base)),
upper = rep(NA, length(var_info$base)),
coef  = rep(NA, length(var_info$base)))
full_vals[child_indices, ] <- vals
return(full_vals)
}
return(vals)
}
# --- Run Processing ---
# 1. Adult
res_adult <- process_group(age_group_data$adult, "Adult")
res_teen  <- process_group(age_group_data$teen, "Teen")
res_child <- process_group(age_group_data$child, "Child", is_child = TRUE)
# --- Construct Dataframe ---
all_coef  <- c(res_adult$coef,  res_teen$coef,  res_child$coef)
all_lower <- c(res_adult$lower, res_teen$lower, res_child$lower)
all_upper <- c(res_adult$upper, res_teen$upper, res_child$upper)
n_vars <- length(var_info$labels)
x_labels <- var_info$labels
df <- data.frame(
y     = factor(rep(x_labels, times = 3), levels = x_labels),
x     = all_coef,
xmin  = all_lower,
xmax  = all_upper,
group = factor(rep(c("Age >18", "Age 11-18", "Age < 10"), each = n_vars),
levels = c("Age >18", "Age 11-18", "Age < 10"))
)
df <- df[!(is.na(df$x) & df$group == "Age < 10"), ]
y_limit <- max(abs(c(df$xmax, df$xmin)), na.rm = TRUE)
g <- ggplot(df, aes(x = y, y = x, fill = group)) +
geom_vline(xintercept = seq(1.5, n_vars - 0.5, by = 1),
color = "grey60", linetype = "dashed") +
geom_hline(yintercept = 0, color = "black", linewidth = 1.2) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8), width = 0.7, alpha = 0) +
geom_errorbar(aes(ymin = xmin, ymax = xmax, color = group),
position = position_dodge(width = 0.8),
width = 0.2) +
geom_point(aes(shape = group, color = group),
position = position_dodge(width = 0.8), size = 3) +
scale_y_continuous(
breaks = scales::pretty_breaks(),
limits = c(-y_limit, y_limit)
) +
labs(x = "Outcome", y = "Standardized effect size (mean slope / SD of slopes)",
fill = "Age Group", color = "Age Group", shape = "Age Group",
title = paste(study_group, "- Within-group effect sizes (Approach 2)"),
caption = Caption) +
coord_flip() +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 0, hjust = 1),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(color = "grey80")
)
return(list(plot = g, df = df))
}
VOM = c("Cereb_vol","SCP_vol",
"Whole_brainstem","Medulla","Pons","Midbrain",
"bCSA_C12_UMN","csa_c1c2",
"DN_vol", "DN_suscept",
"FA.SCP","RD.SCP")
VOM_v2 = paste0(VOM,"_v2"); VOM_v3 = paste0(VOM,"_v3")
All_long_adult = All_long %>% filter(Age >= 18)
All_long_adult$visit <- ave(
seq_len(nrow(All_long_adult)),
All_long_adult$ID,
FUN = seq_along
)
lme_list_adult = lme_pom(All_long_adult,VOM)
All_long_teen = All_long %>% filter(Age < 18 & Age >= 11)
All_long_teen$visit <- ave(
seq_len(nrow(All_long_teen)),
All_long_teen$ID,
FUN = seq_along
)
lme_list_teen = lme_pom(All_long_teen, VOM)
All_long_under = All_long %>% filter(Age < 11)
All_long_under$visit <- ave(
seq_len(nrow(All_long_under)),
All_long_under$ID,
FUN = seq_along
)
lme_list_under = lme_pom(All_long_under, VOM[-c(9:12)])
inputs <- list(adult = lme_list_adult, teen = lme_list_teen, child = lme_list_under)
vars   <- list(base = VOM, v2 = VOM_v2, v3 = VOM_v3, labels = VOM)
child_idx <- c(1:8) # Indices corresponding to the child models in the full list
