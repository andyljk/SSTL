from = log(0.05)
num = 10
to = log(1)
c_list = exp(seq(from, to, (to-from)/(num-1)))
#c = 0.05
RSE = c()
for (k in 1:length(c_list)){
c = c_list[k]
tau_u = rep(1,rk)*sqrt(c)
tau_v = rep(1,rk)*sqrt(c)
S_list = as.list(rep(NA, 10))
U. = matrix(rep(1,p*rk),nrow = p)
for (j in 1:rk){
U.[,j] = rnorm(p, 0, tau_u[j])
}
V. = matrix(rep(1,n*rk),nrow = n)
for (i in 1:rk){
V.[,i] = rnorm(n, 0, tau_v[i])
}
S. = c*U.%*%t(V.)
for (l in 1:10){
E = matrix(rnorm(p*n,0,sig.*1), nrow = p)
#mean(S./E)
