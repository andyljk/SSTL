res_ctrl_slope <- plot_within_group_approach2(age_group_data_ctrl, vars_ctrl, child_idx, study_group="Control")
res_frda_slope$plot / res_ctrl_slope$plot + plot_layout(guides = "collect")
write.csv(res_frda_slope$df, file="ES_within_FRDA_approach2.csv")
write.csv(res_ctrl_slope$df, file="ES_within_CTRL_approach2.csv")
baseline_data <- All_long[All_long$Time == 0, ]
pct_df <- data.frame(y = character(), x = numeric(), xmin = numeric(), xmax = numeric(), group = character(), stringsAsFactors = FALSE)
for (var_name in VOM) {
mean_base_adult <- mean(baseline_data[[var_name]][baseline_data$Age >= 18 & baseline_data$Study.group == "Friedreich ataxia"], na.rm = TRUE)
model_adult <- lme_list_adult_frda[[var_name]]
ci_adult <- confint(model_adult, method = "Wald")
coef_adult <- summary(model_adult)$coefficients["Time", 1]
idx_adult <- which(rownames(ci_adult) == "Time")
pct_df <- rbind(pct_df, data.frame(
y = var_name,
x = (coef_adult / mean_base_adult) * 100,
xmin = (ci_adult[idx_adult, 1] / mean_base_adult) * 100,
xmax = (ci_adult[idx_adult, 2] / mean_base_adult) * 100,
group = "Age >18"
))
mean_base_teen <- mean(baseline_data[[var_name]][baseline_data$Age >= 11 & baseline_data$Age < 18 & baseline_data$Study.group == "Friedreich ataxia"], na.rm = TRUE)
model_teen <- lme_list_teen_frda[[var_name]]
ci_teen <- confint(model_teen, method = "Wald")
coef_teen <- summary(model_teen)$coefficients["Time", 1]
idx_teen <- which(rownames(ci_teen) == "Time")
pct_df <- rbind(pct_df, data.frame(
y = var_name,
x = (coef_teen / mean_base_teen) * 100,
xmin = (ci_teen[idx_teen, 1] / mean_base_teen) * 100,
xmax = (ci_teen[idx_teen, 2] / mean_base_teen) * 100,
group = "Age 11-18"
))
}
child_idx <- -c(9:12)
for (var_name in VOM[child_idx]) {
