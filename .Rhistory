clin_vars_assoc = c("mfars", "adl", "fss", "sara")
vars_ind = match(VOM, names(All_long))
Pc = Pc_p = data.frame(VOM,1:length(VOM),1:length(VOM),1:length(VOM),1:length(VOM))
names(Pc_p) = names(Pc) = c("OMs","mFARS","ADL","FSS","SARA")
for (i in 1:length(VOM)){
for (j in 1:4){
df_sub = All_long[which(All_long$Age>18),c("ID","Age","Gender","education","Study.group",clin_vars_assoc[j],VOM[i])]
names(df_sub)[c(6,7)] = c("clin","vom")
lme_clin = lme(clin ~ vom + Age + Gender + education, random = ~ 1 | ID, data=df_sub, na.action = "na.omit")
Pc_p[i,j+1] = summary(lme_clin)$tTable[2,5]
Pc[i,j+1] = cor.test(df_sub$clin, df_sub$vom, use = "pairwise.complete.obs")$estimate
}
}
bold_w_sig(Pc,Pc_p,color=T,upper=0.9) %>%
kbl(escape = FALSE) %>%
kable_styling()
