abline(v = burn, col='red')
hist(mu_list[c(burn:iter)], freq = FALSE,breaks=40, main="Histogram of posterior draws, mu", xlab = 'mu')
source("~/Desktop/Bayesian_BIDIFAC/BIDIFAC_code/BIDIFAC.R")
source("~/Desktop/Bayesian_BIDIFAC/BIDIFAC_code/EV_BIDIFAC_Functions.R")
library(MASS)
library(beepr)
get_tau = function(X){
L = dim(X)[1] # nrows
M = dim(X)[2] # ncols
s = get_sigma(X)^0.5 # EVB sigma est
thres = (sqrt(L)+sqrt(M))*s # threshold value from nakajima 2013
sing_vals = svd(X)$d # singular values of X
rk = sum(sing_vals>thres) # n of singular values to be used
g = sing_vals[1:rk]
prod = 1/(2*n*p)*(g^2-(n+p)*s^2+sqrt((g^2-(n+p)*s^2)^2-4*n*p*s^4)) # following nakajima 2013
tau = prod^0.25
return(list(tau,rk))
}
Fac = function(X, S., iter = 5.0e3, burn = 1e3){
## Run Gibbs sampler based on normal priors for U, V
p = dim(X)[1]
n = dim(X)[2]
U_draw = as.list(rep(NA, iter))
V_draw = as.list(rep(NA, iter))
S_draw = as.list(rep(NA, iter))
#sig_draw = c()
#svdX = svd(X, nu = p, nv = n)
#U = matrix(rep(0, p*rk), nrow = p)
#V = matrix(rep(0, n*rk), nrow = n)
sig = get_sigma(X)^(1/2) # EV-BIDIFAC solution
#sig = sig.
tau_u = tau_v = get_tau(X)[[1]]
rk = get_tau(X)[[2]]
U = matrix(0,p,rk)
V = matrix(0,n,rk)
#T. = diag(1,rk,rk)
#sig = sigma.rmt(X) # Random Matrix Theory solution
#std = get_sigma(X)^(1/2)
#X = X/std # standardize
#tau_u = tau_v = get_tau(X)[[1]]
T_v = diag(tau_v^2)
T_u = diag(tau_u^2)
if (rk==1){
T_v = tau_v^2
T_u = tau_u^2
}
#SIG = diag(sig, p, p)
pb = txtProgressBar(min = 0, max=iter, initial=0, char="-", style = 3)
for (t in 1:iter){
setTxtProgressBar(pb, t)
# update V
for (i in 1:n){
B_v = solve(t(U)%*%U + (sig^2)*solve(T_v))
b_v = t(U)%*%X[,i]
V[i,] = mvrnorm(n=1, mu = B_v%*%b_v, Sigma = (sig^2)*B_v)
}
# update U
for (j in 1:p){
B_u = solve(t(V)%*%V + (sig^2)*solve(T_u))
b_u = t(V)%*%X[j,]
U[j,] = mvrnorm(n=1, mu = B_u%*%b_u, Sigma = (sig^2)*B_u)
}
# update sigma^2
# alpha = n*p/2 + 1
# beta = 2/frob(X-U%*%t(V))+1
# sig = 1/rgamma(n=1, alpha, 1/beta)
S = U %*% t(V)
U_draw[[t]] = U
V_draw[[t]] = V
S_draw[[t]] = S #*std
#sig_draw = c(sig_draw, sig)
}
return(list(U_draw, V_draw, S_draw))
}
Check_CI = function(S_draw, S., iter, burn){
P = dim(S.)[1]
N = dim(S.)[2]
# Construct empirical CIs for each entry
lower = matrix(rep(NA,P*N),nrow = P)
upper = matrix(rep(NA,P*N),nrow = P)
S_mean = matrix(rep(NA,P*N),nrow = P)
for (j in 1:P){
for (i in 1:N){
S_entry = c()
for (t in (burn+1):iter){
S_entry[t-burn] = S_draw[[t]][j,i]
}
lower[j,i] = quantile(S_entry, 0.025)
upper[j,i] = quantile(S_entry, 0.975)
}
}
hist(S_entry)
plot(1:(iter-burn),S_entry)
autocor = acf(S_entry, plot=F)
#hist(sig_draw[(burn+1):iter])
S_mean = Reduce("+", S_draw) / length(S_draw)
CI_indicator = matrix(rep(NA, P*N), nrow=P)
for (j in 1:P){
for (i in 1:N){
CI_indicator[j,i] = ifelse(S.[j,i] > lower[j,i] && S.[j,i] < upper[j,i], 1, 0)
}
}
return(c(sum(CI_indicator)/(P*N), autocor))
}
BF_impute = function(Y, Y_true, rk, iter = 8e3, burn = 2e3, tau_u, tau_v){
missing_ind = which(is.na(Y),arr.ind = T)
Y_0 = fill.matrix(Y)$X.fill
sig = eb.glob.imp(Y)[[2]]^(1/2) # evb sigma estimate w/ imputation
p = dim(Y)[1]
n = dim(Y)[2]
U_draw = as.list(rep(NA, iter))
V_draw = as.list(rep(NA, iter))
S_draw = as.list(rep(NA, iter))
Y_draw = as.list(rep(NA, iter))
#sig_draw = c()
#svdX = svd(X, nu = p, nv = n)
#U = matrix(rep(0, p*rk), nrow = p)
#V = matrix(rep(0, n*rk), nrow = n)
U = matrix(0,p,rk)
V = matrix(0,n,rk)
#T. = diag(1,rk,rk)
pb = txtProgressBar(min = 0, max=iter, initial=0, char="-", style = 3)
for (t in 1:iter){
setTxtProgressBar(pb, t)
# set sigma
#sig = get_sigma(Y_0)^(1/2) # EV-BIDIFAC solution
T_v = diag(tau_v^2) # Cov matx for priors of U and V
T_u = diag(tau_u^2)
# update V
for (i in 1:n){
B_v = solve(t(U)%*%U + (sig^2)*solve(T_v))
b_v = t(U)%*%Y_0[,i]
V[i,] = mvrnorm(n=1, mu = B_v%*%b_v, Sigma = (sig^2)*B_v)
}
# update U
for (j in 1:p){
B_u = solve(t(V)%*%V + (sig^2)*solve(T_u))
b_u = t(V)%*%Y_0[j,]
U[j,] = mvrnorm(n=1, mu = B_u%*%b_u, Sigma = (sig^2)*B_u)
}
S = U %*% t(V)
U_draw[[t]] = U
V_draw[[t]] = V
S_draw[[t]] = S
# update missing entries of Y_0
for (k in 1:dim(missing_ind)[1]){
Y_0[missing_ind[k,1],missing_ind[k,2]] = rnorm(1,S[missing_ind[k,1],missing_ind[k,2]],sig)
}
Y_draw[[t]] = Y_0
}
# Construct empirical CIs for each non-missing entry
lower = matrix(rep(NA,p*n),nrow = p)
upper = matrix(rep(NA,p*n),nrow = p)
S_mean = matrix(rep(NA,p*n),nrow = p)
for (i in 1:p){
for (j in 1:n){
S_entry = c()
for (t in (burn+1):iter){
S_entry[t-burn] = S_draw[[t]][i,j]
}
lower[i,j] = quantile(S_entry, 0.025)
upper[i,j] = quantile(S_entry, 0.975)
S_mean[i,j] = mean(S_entry)
}
}
hist(S_entry)
#hist(sig_draw[(burn+1):iter])
CI_indicator = matrix(rep(NA, p*n), nrow=p)
for (i in 1:p){
for (j in 1:n){
CI_indicator[i,j] = ifelse(X[i,j] > lower[i,j] && X[i,j] < upper[i,j], 1, 0)
}
}
# Construct empirical CIs for each non-missing entry
Ylower = matrix(rep(NA,p*n),nrow = p)
Yupper = matrix(rep(NA,p*n),nrow = p)
Y_mean = matrix(rep(NA,p*n),nrow = p)
for (k in 1:dim(missing_ind)[1]){
Y_entry = c()
for (t in (burn+1):iter){
Y_entry[t-burn] = Y_draw[[t]][missing_ind[k,1],missing_ind[k,2]]
}
Ylower[missing_ind[k,1],missing_ind[k,2]] = quantile(Y_entry, 0.025)
Yupper[missing_ind[k,1],missing_ind[k,2]] = quantile(Y_entry, 0.975)
Y_mean[missing_ind[k,1],missing_ind[k,2]] = mean(Y_entry)
}
hist(Y_entry)
#hist(sig_draw[(burn+1):iter])
Y.CI_indicator = matrix(rep(NA, p*n), nrow=p)
for (k in 1:dim(missing_ind)[1]){
Y.CI_indicator[missing_ind[k,1],missing_ind[k,2]] = ifelse(Y_true[missing_ind[k,1],missing_ind[k,2]] > Ylower[missing_ind[k,1],missing_ind[k,2]]
&& Y_true[missing_ind[k,1],missing_ind[k,2]] < Yupper[missing_ind[k,1],missing_ind[k,2]], 1, 0)
}
missing_CI_sum = sum(Y.CI_indicator, na.rm=T)
return(list(mean(CI_indicator), S_mean, missing_ind, missing_CI_sum/dim(missing_ind)[1]))
}
# generate column or row-wise missingness for X
X_1 = X
ind.row=sample(p,round(0.05*p))
ind.col=sample(n,round(0.05*n))
X_1[ind.row,] = NA
X_1[,ind.col] = NA
# generate random missingness for X
X_2 = X
NA_ind = matrix(rbinom(p*n,1,0.05), p, n)
for (i in 1:p){
for (j in 1:n){
if (NA_ind[i,j] == 1){X_2[i,j] = NA}
}
}
imp_sol = BF_impute(X_2, Y_true = X, rk=rk, tau_u = tau_u, tau_v = tau_v)
imp_sol[[4]]
imp_sol[[1]]
