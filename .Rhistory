iter = 10000
burn = 2000
tau2 = 225
m = length(y)
y_i_bar = sapply(y,mean)
n_i_s = sapply(y,length)
n = sum(n_i_s)
sig2 = 36 ##intitialize sigma^2 to 64
mu=100 ##initialize mu to 100
theta = c() # draw theta first so no initialization
mu_list = rep(NA,iter)
sig2_list = rep(NA,iter)
theta_list = matrix(NA, nrow = m, ncol = iter) # draw theta first
for (t in 1:iter){
for (i in 1:m){
post_mean = (sig2*mu+n_i_s[i]*tau2*y_i_bar[i])/(n_i_s[i]*tau2+sig2)
post_var = (sig2*tau2)/(n_i_s[i]*tau2+sig2)
theta[i] = rnorm(1, post_mean, sqrt(post_var))
}
#ss = 0
#for (a in 1:m){
#  ss = ss + sum((y[[a]] - theta[a])^2)
#}
#sig2 = 1/rgamma(1, n/2, ss/2)
#sig2_list[t] = sig2
mu = rnorm(1, mean(theta), sqrt(tau2/m))
mu_list[t] = mu
theta_list[,t] = theta
}
