All_long_adult = All_long %>% filter(Age >= 18)
All_long_adult$visit <- ave(
seq_len(nrow(All_long_adult)),
All_long_adult$ID,
FUN = seq_along
)
lme_list_adult_frda = lme_within(All_long_adult[which(All_long_adult$Study.group=="Friedreich ataxia"),],VOM_frda)
lme_list_adult_ctrl = lme_within(All_long_adult[which(All_long_adult$Study.group=="Control"),],VOM)
All_long_teen = All_long %>% filter(Age < 18 & Age >= 11)
All_long_teen$visit <- ave(
seq_len(nrow(All_long_teen)),
All_long_teen$ID,
FUN = seq_along
)
lme_list_teen_frda = lme_within(All_long_teen[which(All_long_teen$Study.group=="Friedreich ataxia"),],VOM_frda)
lme_list_teen_ctrl = lme_within(All_long_teen[which(All_long_teen$Study.group=="Control"),],VOM)
All_long_under = All_long %>% filter(Age < 11)
All_long_under$visit <- ave(
seq_len(nrow(All_long_under)),
All_long_under$ID,
FUN = seq_along
)
lme_list_under_frda = lme_within(All_long_under[which(All_long_under$Study.group=="Friedreich ataxia" & All_long_under$ID!='UMN028'),],VOM_frda[-c(9:12)])
lme_list_under_ctrl = lme_within(All_long_under[which(All_long_under$Study.group=="Control"),],VOM[-c(9:12)])
