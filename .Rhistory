library(NTL)
library(extRemes)
library(posterior)
library(pROC)
# data
set.seed(714)
p     = 150; p_0 = p/10
n     = 200
sd_y  = 1
b0    = c(rep(0.5,p_0), rep(0, p-p_0))
X     = matrix(rnorm(p*n), n,p)
logT  = X%*%b0 - revd(n,0,sd_y) # log survival time
logC  = rnorm(n, mean(logT), sd(logT))
Y     = pmin(logT, logC)
C     = as.integer(logT <= logC)
lam_eb = EB_SAEM_AFT(X,Y,C,N=10000,gamma_power=0.9,K_block=20,family='Weibull', slab="nlp1")
plot(lam_eb$mc.lam)
lam = lam_eb$lambda_final
t0    = Sys.time()
MC  = ESS_Gibbs_AFT(X,Y,C,lambda=lam, N=10000, family='Weibull', slab="exp")
t1    = Sys.time()
print(t1-t0, digits = 2)
