library(NTL)
# 1. Simulate tiny data
set.seed(123)
sim <- sim_data(p=10, n_t=50, n_s=50, S=2)
# 2. Run the main function (short chain)
fit <- ESS_Gibbs_TL(
X_T = sim$X_T,
Y_T = sim$Y_T,
X_s = sim$X_s,
Y_s = sim$Y_s,
N = 100,       # Short chain for testing
verbose = 1
)
# 3. Check if we got output
print(dim(fit$mc.bt)) # Should be c(100, 21) -> 2p+1 params
print("Test Complete!")
dim(fit$MC_beta)
