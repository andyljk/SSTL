# data
set.seed(456)
p     = 150; p_0 = p/10
n     = 200
sd_y  = 1
b0    = c(rep(0.5,p_0), rep(0, p-p_0))
X     = matrix(rnorm(p*n), n,p) # rmvn(n,rep(0,p),AR1_cov(p,rho=0.7)) #
Y     = X%*%b0 + rnorm(n,0,sd_y)
id    = lapply(seq(1, (2*p-1), 5), function(i) i + 0:4)
id = c(id, list(2*p+1))
b.c   = c(b0, rep(0,p), 0)
sd.0  = sqrt(c(rep(.75, p), rep(1,p), 1))
T.n   = function(b) pmax(b, 0)
beta  = function(b,lambda) b[1:p]*T.n(b[(p+1):(2*p)]-qnorm(pnorm(b[2*p+1])^(1/lambda)))
L.exa = function(b, lambda, sd_y)
sum(dnorm(x=Y, mean=X%*%beta(b,lambda), sd=sd_y, log=T))  # log-likelihood function
lam = ESS.Gibbs.EB(b.c,LL=L.exa,id,sd.0,N=2000,max_iter = 10)
